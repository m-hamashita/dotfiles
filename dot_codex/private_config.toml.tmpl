{{- $codex := (index . "codex") | default dict -}}
model = {{ quote (index $codex "model" | default "gpt-5.2-codex") }}
model_reasoning_effort = {{ quote (index $codex "model_reasoning_effort" | default "medium") }}

{{- range $p := (index $codex "trusted_projects" | default (list)) }}
[projects."{{ $p }}"]
trust_level = "trusted"
{{- end }}

{{- range $p := (index $codex "untrusted_projects" | default (list)) }}
[projects."{{ $p }}"]
trust_level = "untrusted"
{{- end }}

[mcp_servers.context7]
command = "npx"
args = ["-y", "@upstash/context7-mcp"]
startup_timeout_sec = 20.0
tool_timeout_sec = 60.0

rmcp_client = true

[mcp_servers.notion]
url = "https://mcp.notion.com/mcp"

[notice.model_migrations]
"gpt-5.2" = "gpt-5.2-codex"

[features]
web_search_request = true
