[url "ssh://git@github.com/"]
    insteadOf = https://github.com/

[user]
	name = m-hamashita
	email = masakatsu.hamashita@gmail.com

[merge]
	ff = false
    conflictstyle = diff3

[pull]
	ff = only

[color]
    ui = auto

[push]
	default = simple

[alias]
	co = checkout
	st = status
    taglog = "log --tags --simplify-by-decoration --pretty=\"format:%ci %d\""
	ci = commit -a

[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[ghq]
	root = ~/work

[difftool]
	prompt = false

[branch]
	sort = -authordate

[secrets]
	providers = git secrets --aws-provider
	patterns = (A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}
	patterns = (\"|')?(AWS|aws|Aws)?_?(SECRET|secret|Secret)?_?(ACCESS|access|Access)?_?(KEY|key|Key)(\"|')?\\s*(:|=>|=)\\s*(\"|')?[A-Za-z0-9/\\+=]{40}(\"|')?
	patterns = (\"|')?(AWS|aws|Aws)?_?(ACCOUNT|account|Account)_?(ID|id|Id)?(\"|')?\\s*(:|=>|=)\\s*(\"|')?[0-9]{4}\\-?[0-9]{4}\\-?[0-9]{4}(\"|')?
	allowed = AKIAIOSFODNN7EXAMPLE
	allowed = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

[mergetool]
	prompt = false

# for delta
[core]
    pager = delta --syntax-theme gruvbox-dark
[interactive]
    diffFilter = delta --color-only
[delta]
    # use n and N to move between diff sections
    navigate = true    
    # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
    light = false
    side-by-side = false
[diff]
    colorMoved = default
[wt]
	basedir = ~/work/{gitroot}-worktrees
